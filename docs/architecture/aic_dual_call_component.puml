@startuml AIC_Dual_Call_Component
title 《天台十句》AIC 双调用链路组件图

left to right direction
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam defaultFontName "Microsoft YaHei"
skinparam component {
  BackgroundColor #F7FAFC
  BorderColor #334155
  FontColor #0F172A
}
skinparam package {
  BackgroundColor #F8FAFC
  BorderColor #64748B
  FontColor #0F172A
}
skinparam database {
  BackgroundColor #ECFDF5
  BorderColor #047857
}
skinparam cloud {
  BackgroundColor #EFF6FF
  BorderColor #2563EB
}

actor "玩家" as Player

package "legacy_vue 前端" as Frontend {
  component "GameView\n自由输入 / 状态反馈" as GameView
  component "gameStore\n机会、信任、姿态、结局状态机" as Store
  component "LLMService\nAPI 序列化与响应归一化" as Client
  component "SaveSystem\nCRC32 本地存档" as Save
}

package "backend Go / Gin" as Backend {
  component "Chat Handler\n请求校验与配置选择" as Handler
  component "LLM Service\n调用编排器" as Orchestrator
  component "角色生成 LLM\nbuildMainSystemPrompt()\n自然对白" as RoleLLM
  component "独立裁判 LLM\nbuildTurnEvaluationSystemPrompt()\n结构化评价 JSON" as JudgeLLM
  component "提示 / 复盘 LLM\nPFA + MI/OARS Prompt" as SupportLLM
  component "规则守门\n字段归一化 · 信任结算 · 结局门槛" as Gate
}

cloud "模型服务商\nOpenAI-compatible / Anthropic" as Providers
database "浏览器 LocalStorage\n主线 / 后日谈 / 成就" as Storage

Player --> GameView : 输入一句话 / 请求提示
GameView --> Store : action
Store --> Client : chat / hint / ending-summary
Store --> Save : 保存与读取
Save --> Storage

Client --> Handler : HTTP /api/*
Handler --> Orchestrator : 结构化请求
Orchestrator --> RoleLLM : ① 生成自然对白
RoleLLM --> Orchestrator : assistant_reply
Orchestrator --> JudgeLLM : ② 评价本句 + 角色回复
JudgeLLM --> Orchestrator : evaluation JSON
Orchestrator --> Gate : 归一化与确定性守门
Gate --> Handler : ChatResponse
Handler --> Client : reply + evaluation
Client --> Store : 归一化状态
Store --> GameView : 对白 / 情绪 / 状态 / 结局

Handler --> SupportLLM : /api/hint\n/api/ending-summary\n/api/chat-after
SupportLLM --> Handler : hint / review / follow-up
Orchestrator --> Providers
SupportLLM --> Providers

note right of JudgeLLM
逻辑职责独立于角色生成：
不直接改写对白，只输出
可审计的结构化评价。
可与角色调用使用同一或不同
模型服务商；不等于双模型真相验证。
end note

note bottom of Gate
程序不把模型输出当作最终事实：
先归一化字段，再执行信任结算、
低信任拦截和机会耗尽兜底结局。
end note

@enduml

