{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiantaishiju.local/contracts/game.v2.json",
  "title": "天台十句 v2 protocol",
  "type": "object",
  "$defs": {
    "phase": {"type": "string", "enum": ["playing", "ended", "after_story"]},
    "ending": {"type": "string", "enum": ["end_death", "end_disappear", "end_acquaintance"]},
    "ai_state": {"type": "string", "enum": ["guarded", "watching", "wavering", "turn_back", "edge"]},
    "emotion": {"type": "string", "enum": ["normal", "sting", "surprise", "soft", "curiosity"]},
    "position": {"type": "string", "enum": ["rooftop_edge", "rooftop_inner", "left_alone", "contact_exchanged"]},
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "content"],
      "properties": {
        "role": {"type": "string", "enum": ["user", "assistant"]},
        "content": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "submit_turn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command_id", "session_id", "expected_revision", "text"],
      "properties": {
        "command_id": {"type": "string", "minLength": 8, "maxLength": 80},
        "session_id": {"type": "string", "minLength": 8, "maxLength": 80},
        "expected_revision": {"type": "integer", "minimum": 0},
        "text": {"type": "string", "minLength": 1, "maxLength": 400}
      }
    },
    "public_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "session_id", "revision", "phase", "opportunities", "hints_remaining", "touches", "affection", "ai_state", "emotion", "position", "messages", "ending"],
      "properties": {
        "schema_version": {"const": 2},
        "session_id": {"type": "string"},
        "revision": {"type": "integer", "minimum": 0},
        "phase": {"$ref": "#/$defs/phase"},
        "opportunities": {"type": "integer", "minimum": 0, "maximum": 10},
        "hints_remaining": {"type": "integer", "minimum": 0, "maximum": 3},
        "touches": {"type": "integer", "minimum": 0},
        "affection": {"type": "integer", "minimum": 0},
        "ai_state": {"$ref": "#/$defs/ai_state"},
        "emotion": {"$ref": "#/$defs/emotion"},
        "position": {"$ref": "#/$defs/position"},
        "messages": {"type": "array", "items": {"$ref": "#/$defs/message"}},
        "ending": {"anyOf": [{"$ref": "#/$defs/ending"}, {"type": "null"}]}
      }
    },
    "turn_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reply", "emotion", "ai_state", "touch_signal", "pressure_delta", "recovery_signal", "contact_exchange_signal", "fatal_signal", "confidence"],
      "properties": {
        "reply": {"type": "string", "minLength": 1, "maxLength": 200},
        "emotion": {"$ref": "#/$defs/emotion"},
        "ai_state": {"$ref": "#/$defs/ai_state"},
        "touch_signal": {"type": "boolean"},
        "pressure_delta": {"type": "integer", "minimum": 0, "maximum": 2},
        "recovery_signal": {"type": "boolean"},
        "contact_exchange_signal": {"type": "boolean"},
        "fatal_signal": {"type": "boolean"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
