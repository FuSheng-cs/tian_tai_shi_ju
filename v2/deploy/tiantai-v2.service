[Unit]
Description=Tiantai Shiju v2 narrative service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tiantai-v2
Group=tiantai-v2
WorkingDirectory=/srv/tiantai-v2/current
ExecStart=/srv/tiantai-v2/current/tiantai-v2
Environment=V2_LISTEN_ADDR=127.0.0.1:8082
Environment=V2_DATA_DIR=/var/lib/tiantai-v2
Environment=V2_PUBLIC_ORIGIN=https://v2.tiantaishiju.top
Environment=V2_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
EnvironmentFile=-/etc/tiantai-v2.env
StateDirectory=tiantai-v2
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=3
TimeoutStopSec=65
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/tiantai-v2
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
