# V2 ONLY. Verify the existing v2 virtual host and certificate paths before use.
# Never install this as the default site or alter tiantaishiju.top's virtual host.
server {
    listen 443 ssl;
    server_name v2.tiantaishiju.top;
    ssl_certificate /etc/letsencrypt/live/v2.tiantaishiju.top/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/v2.tiantaishiju.top/privkey.pem;
    root /srv/tiantai-v2/current/web;
    index index.html;
    client_max_body_size 16k;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; media-src 'self' blob:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    location /api/v2/ {
        access_log off; # Capability session IDs must not enter proxy logs.
        # Upstream failures otherwise put capability URLs into the error log.
        error_log /dev/null;
        proxy_pass http://127.0.0.1:8082;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 55s;
        proxy_buffering off;
        add_header Cache-Control "no-store" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header X-Content-Type-Options "nosniff" always;
    }
    location /assets/ {
        try_files $uri =404;
        expires 1y;
    }
    location /art/ {
        try_files $uri =404;
        expires 1h;
    }
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; media-src 'self' blob:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    }
}
