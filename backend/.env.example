# 复制为 .env；不要提交真实密钥。无玩家 Key 时使用以下完整配置。
# 服务商：deepseek / qwen / doubao / kimi / zhipu / openai / claude / custom
LLM_PROVIDER=deepseek
# LLM_API_KEY=填写服务商 API Key
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com
PORT=8080

# 模型留空时使用 Provider 默认值（2026-10-01）：
# deepseek: deepseek-flash；qwen: qwen3.7-plus
# doubao: doubao-seed-2-1-lite-260915；kimi: kimi-k2.6
# zhipu: glm-5.3-flash；openai: gpt-6-luna；claude: claude-sonnet-5-5
# custom 必须填写模型和 Base URL；豆包也可填写已开通的 ep- 接入点 ID。
# Key 必须匹配服务商、地域和计费产品；Coding Plan / 聊天订阅不等于按量 API。
